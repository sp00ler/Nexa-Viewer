<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ViewerPrn.App.FolderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ViewerPrn.App">

    <Grid RowDefinitions="*,Auto">

        <!-- ListView virtualises rows by default; nothing extra is needed for large folders. -->
        <ListView
            x:Name="Entries"
            Grid.Row="0"
            SelectionMode="Extended"
            IsDoubleTapEnabled="True"
            ContainerContentChanging="OnContainerContentChanging"
            DoubleTapped="OnDoubleTapped"
            KeyDown="OnKeyDown"
            SelectionChanged="OnSelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:EntryRow">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="0,2">
                        <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="16"
                                Glyph="{x:Bind Glyph}"
                                Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                            <Image
                                Source="{x:Bind Thumbnail, Mode=OneWay}"
                                Stretch="Uniform" />
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" Margin="16,0" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{x:Bind ModifiedText}" Opacity="0.7" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="RenameMenuItem" Click="OnRenameClick" />
                    <MenuFlyoutItem x:Name="DeleteMenuItem" Click="OnDeleteClick" />
                </MenuFlyout>
            </ListView.ContextFlyout>
        </ListView>

        <TextBlock
            x:Name="MessageText"
            Grid.Row="0"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <ProgressBar x:Name="Busy" Grid.Row="1" IsIndeterminate="True" Visibility="Collapsed" />
    </Grid>
</UserControl>
