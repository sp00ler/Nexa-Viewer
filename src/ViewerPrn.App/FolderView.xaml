<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ViewerPrn.App.FolderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ViewerPrn.App">

    <UserControl.Resources>
        <!-- The context menu is shared by both controls; only one is visible at a time. -->
        <MenuFlyout x:Name="EntryMenu">
            <MenuFlyoutItem x:Name="CopyMenuItem" Click="OnCopyClick" />
            <MenuFlyoutItem x:Name="CutMenuItem" Click="OnCutClick" />
            <MenuFlyoutItem x:Name="PasteMenuItem" Click="OnPasteClick" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="CopyToMenuItem" Click="OnCopyToClick" />
            <MenuFlyoutItem x:Name="MoveToMenuItem" Click="OnMoveToClick" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="RenameMenuItem" Click="OnRenameClick" />
            <MenuFlyoutItem x:Name="DeleteMenuItem" Click="OnDeleteClick" />
        </MenuFlyout>

        <!--
            WinUI sizes list rows for a fingertip: ListViewItem.MinHeight is 40, which is twice
            what the row's own content needs and half the files on screen. This is a
            keyboard-and-mouse file list, so the row is as tall as its 20px icon plus breathing
            room. Shrinking the font instead would cost legibility and change nothing while the
            container holds 40.
        -->
        <Style x:Key="CompactRow" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="8,0" />

            <!--
                Without this the row is only as wide as its own text: ListViewItem aligns its
                content Left by default, the star column collapses onto the file name, and every
                row puts the size and date in a different place. Stretch is what makes the
                columns columns.
            -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!--
            Details: thumbnail, name, size, date. The last two columns are fixed widths, not
            Auto: Auto is measured per row, so every row sized its own columns and the numbers
            and dates never lined up. These widths are repeated by the header above the list —
            change one, change the other.
        -->
        <DataTemplate x:Key="DetailsTemplate" x:DataType="local:EntryRow">
            <Grid ColumnDefinitions="30,*,100,140" Padding="0,1">
                <Grid Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Left">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="{x:Bind Glyph}"
                              Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" Opacity="0.7" VerticalAlignment="Center"
                           TextAlignment="Right" Margin="0,0,12,0" />
                <TextBlock Grid.Column="3" Text="{x:Bind ModifiedText}" Opacity="0.7" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- List: names only. -->
        <DataTemplate x:Key="ListTemplate" x:DataType="local:EntryRow">
            <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,1">
                <Grid Width="20" Height="20">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="{x:Bind Glyph}"
                              Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                </Grid>
                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- Thumbnails: a grid of large pictures with the name underneath. -->
        <DataTemplate x:Key="ThumbnailTemplate" x:DataType="local:EntryRow">
            <StackPanel Width="150" Height="170" Padding="4" Spacing="4">
                <Grid Width="140" Height="128">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="40" Glyph="{x:Bind Glyph}"
                              Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                </Grid>
                <TextBlock Text="{x:Bind Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!--
            Column header, Details only. Tapping one sorts by it; tapping the one already sorted
            reverses it. The widths repeat DetailsTemplate's, plus the row padding, so the two
            line up. The scrollbar's width is the one thing not accounted for.
        -->
        <Grid x:Name="ColumnHeader"
              Grid.Row="0"
              ColumnDefinitions="30,*,100,140"
              Padding="8,4"
              BorderThickness="0,0,0,1"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <TextBlock x:Name="NameHeader" Grid.Column="1" Tapped="OnHeaderTapped" Tag="Name"
                       FontWeight="SemiBold" Margin="0,0,12,0" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Name="SizeHeader" Grid.Column="2" Tapped="OnHeaderTapped" Tag="Size"
                       FontWeight="SemiBold" TextAlignment="Right" Margin="0,0,12,0" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Name="ModifiedHeader" Grid.Column="3" Tapped="OnHeaderTapped" Tag="Modified"
                       FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- ListView and GridView both virtualise; only the one matching the view mode is shown. -->
        <ListView
            x:Name="Entries"
            Grid.Row="1"
            SelectionMode="Extended"
            IsDoubleTapEnabled="True"
            ContainerContentChanging="OnContainerContentChanging"
            DoubleTapped="OnDoubleTapped"
            KeyDown="OnKeyDown"
            SelectionChanged="OnSelectionChanged"
            ContextFlyout="{StaticResource EntryMenu}"
            ItemContainerStyle="{StaticResource CompactRow}"
            ItemTemplate="{StaticResource DetailsTemplate}" />

        <GridView
            x:Name="Tiles"
            Grid.Row="1"
            Visibility="Collapsed"
            SelectionMode="Extended"
            IsDoubleTapEnabled="True"
            ContainerContentChanging="OnContainerContentChanging"
            DoubleTapped="OnDoubleTapped"
            KeyDown="OnKeyDown"
            SelectionChanged="OnSelectionChanged"
            ContextFlyout="{StaticResource EntryMenu}"
            ItemTemplate="{StaticResource ThumbnailTemplate}" />

        <TextBlock
            x:Name="MessageText"
            Grid.Row="1"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <ProgressBar x:Name="Busy" Grid.Row="2" IsIndeterminate="True" Visibility="Collapsed" />
    </Grid>
</UserControl>
