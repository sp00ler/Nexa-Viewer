<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ViewerPrn.App.ViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    KeyDown="OnKeyDown"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

    <Grid RowDefinitions="*,Auto">

        <!--
            Viewbox with StretchDirection="DownOnly" is the whole scaling rule from
            docs/VIEWER.md:10: large images are fitted down proportionally, small ones are shown
            at native size. No code, no arithmetic in the view.
        -->
        <Viewbox x:Name="ImageHost" Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly">
            <Image x:Name="Picture" />
        </Viewbox>

        <TextBlock
            x:Name="LoadFailedText"
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextWrapping="Wrap"
            Margin="24"
            Visibility="Collapsed" />

        <Border
            Grid.Row="1"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto" Padding="12,6">
                <TextBlock
                    x:Name="CounterText"
                    Grid.Column="0"
                    Margin="0,0,16,0"
                    FontWeight="SemiBold"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock
                    x:Name="DetailsText"
                    Grid.Column="1"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="EdgeText"
                    Grid.Column="2"
                    Margin="16,0,0,0"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
